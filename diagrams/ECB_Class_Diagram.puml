ResourceManagementScreen "1" -- "1" LogisticsClientController : uses
CrewMemberScreen "1" -- "1" CrewMemberClientController : uses
AdminScreen "1" -- "1" AdminClientController : uses
ReportScreen "1" -- "1" AdminClientController : uses

LoginClientController "1" -- "1" CrisisSyncClient : sends via
DispatcherClientController "1" -- "1" CrisisSyncClient : sends via
FieldCommanderClientController "1" -- "1" CrisisSyncClient : sends via
CrewMemberClientController "1" -- "1" CrisisSyncClient : sends via
LogisticsClientController "1" -- "1" CrisisSyncClient : sends via
AdminClientController "1" -- "1" CrisisSyncClient : sends via
CrisisSyncClient "1" -- "0..*" UpdateListener : notifies

CrisisSyncClient "1" -- "0..*" Request : sends
CrisisSyncClient "1" -- "0..*" Response : receives
CrisisSyncClient "1" -- "0..*" UpdateNotification : receives

