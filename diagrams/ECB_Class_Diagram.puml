EventController "1" -- "1" SettlementGateway : requests settlement

CrisisSyncServer "1" -- "1" AuthenticationController : routes to
CrisisSyncServer "1" -- "1" EventController : routes to
CrisisSyncServer "1" -- "1" TaskController : routes to
CrisisSyncServer "1" -- "1" ReservationController : routes to
CrisisSyncServer "1" -- "1" ResourceController : routes to
CrisisSyncServer "1" -- "1" ReportController : routes to
CrisisSyncServer "1" -- "1" DataLoadController : routes to
CrisisSyncServer "1" -- "0..*" UpdateNotification : broadcasts

ReservationController "1" -- "1..*" AllocationStrategy : selects resources by
ReportController "1" -- "1..*" ReportGenerator : generates with
ReportController "0..*" -- "1" AuthenticationController : checks permission via
ReservationController "0..*" -- "1" AuditController : records via
TaskController "0..*" -- "1" AuditController : records via
EventController "0..*" -- "1" AuditController : records via
ResourceController "0..*" -- "1" AuditController : records via
AuditController "1" -- "1" CrisisSyncServer : reports entries to

