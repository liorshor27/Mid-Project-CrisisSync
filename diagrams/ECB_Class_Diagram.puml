ReservationController "1" -- "1" ResourceDAO : uses
ReservationController "1" -- "1" AssignmentDAO : uses
ReservationController "1" -- "1" TaskDAO : uses
ResourceController "1" -- "1" ResourceDAO : uses
SLAReportGenerator "1" -- "1" EventDAO : reads
SLAReportGenerator "1" -- "1" TaskDAO : reads
ReportController "1" -- "1" ReportDAO : uses
AuditController "1" -- "1" AuditLogDAO : uses
DataLoadController "1" -- "1" UserDAO : loads into
DataLoadController "1" -- "1" ResourceDAO : loads into
DBConnectionManager "1" -- "0..*" Connection : opens
