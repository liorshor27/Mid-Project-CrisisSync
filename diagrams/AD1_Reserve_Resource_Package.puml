@startuml
title Reserve Resource Package, Report Completion and Release Resources
scale 0.8
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #333333
skinparam SwimlaneTitleFontStyle bold

' ===== Swimlanes: Actors first, then Controllers =====
|#EAF2FB|«Actor» Dispatcher|
|#EAF2FB|«Actor» Field Commander|
|#EAF2FB|«Actor» Field Crew Member|
|#EAF2FB|«Actor» Logistics Officer|
|#F4F4F4|«Controller» ReservationController|
|#F4F4F4|«Controller» TaskController|
|#F4F4F4|«Controller» ResourceController|

' ===== A. Reservation request =====
|#EAF2FB|«Actor» Dispatcher|
start
:Open event status screen;
:Select task;
if (Reservation mode?) then ([manual])
  :Select resources;
else ([automatic])
  :Select allocation criterion;
endif
:Submit reservation request;

' ===== B. Check and reserve =====
|#F4F4F4|«Controller» ReservationController|
:Check task state;
if (Task state?) then ([task not Ready])
  :Reject: "Task is not Ready";
  |«Actor» Dispatcher|
  :View message;
else ([task Ready])
  |«Controller» ReservationController|
  if (Reservation mode?) then ([automatic])
    :Select best available resources by criterion;
  else ([manual])
  endif
  while (Reservation attempt needed?) is ([first attempt or taken resources replaced])
    :Begin transaction;
    :Lock event, task and resource records (ascending ID);
    :Check availability of all package resources;
    if (Resources available?) then ([all available])
      :Set package resources to Reserved;
      :Set task to Active;
      :Commit transaction;
    else ([some unavailable])
      :Rollback transaction;
      if (Alternative possible?) then ([automatic and alternative exists and attempts < 3])
        :Replace only the taken resources;
      else ([manual or no alternative or attempts = 3])
      endif
    endif
  endwhile ([committed or no retry])

  if (Reservation committed?) then ([no])
    :Notify failure and refresh screen;
    |«Actor» Dispatcher|
    :View failure message;
  else ([yes])
    |«Controller» ReservationController|
    fork
      :Record reservation in audit log;
    fork again
      :Push update to all clients (sendToAllClients);
    end fork
    |«Actor» Dispatcher|
    :View task as Active;

    ' ===== C. Carrying out the task and equipment malfunction =====
    |«Actor» Field Commander|
    :Carry out task;
    if (Equipment malfunction?) then ([malfunction found by Field Commander])
      :Report equipment malfunction;
    else ([not found by Field Commander])
      if (Found by Field Crew Member?) then ([yes])
        |«Actor» Field Crew Member|
        :Report equipment malfunction;
      else ([no malfunction])
      endif
    endif
    |«Controller» TaskController|
    if (Malfunction reported?) then ([yes])
      :Release faulty resource and mark it Faulty;
      fork
        :Alert Dispatcher;
        |«Actor» Dispatcher|
        if (Handle missing resource?) then ([replacement needed])
          :Assign replacement resource;
        else ([resource not required])
          :Confirm resource not required;
        endif
      fork again
        |«Controller» TaskController|
        :Notify Logistics Officer of faulty resource;
        |«Actor» Logistics Officer|
        :Handle faulty resource (repair / maintenance);
        :Update maintenance status to Available;
        |«Controller» ResourceController|
        :Set resource to Available;
        :Record resource update in audit log;
      end fork
    else ([no])
    endif

    ' ===== D. Completion report =====
    |«Actor» Field Commander|
    :Report task completion;
    |«Controller» TaskController|
    :Verify assigned Field Commander;
    if (Reporter is the assigned Field Commander?) then ([no])
      :Reject completion report;
    else ([yes])
      if (Missing resource?) then ([resource missing and not waived])
        :Reject: "Task is missing a required resource";
      else ([no missing resource or waived])
        :Set task to Completed;
        fork
          :Release task resources (set to Available);
        fork again
          :Promote dependent tasks to Ready;
        fork again
          :Record completion in audit log;
        end fork
        :Push update to all clients (sendToAllClients);
        |«Actor» Field Commander|
        :View result on event status screen;
      endif
    endif
  endif
endif

' ===== E. End =====
|#F4F4F4|«Controller» TaskController|
stop
@enduml
