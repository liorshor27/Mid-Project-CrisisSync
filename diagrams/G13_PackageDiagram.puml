@startuml G13_PackageDiagram
' CrisisSync - Package Diagram (Group 13)
' Aligned with diagrams/ECB_Class_Diagram.puml (every class belongs to exactly one package).
!pragma layout smetana
top to bottom direction
title CrisisSync - Package Diagram (Layered Architecture, Group 13)

skinparam packageStyle folder
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Arial
skinparam nodesep 40
skinparam ranksep 60

' ---------- UI layer ----------
package "client.boundary" as CB <<layer: UI>> {
}
package "server.boundary" as SB <<layer: UI>> {
}

' ---------- Control layer ----------
package "client.control" as CC <<layer: Control>> {
}
package "server.control" as SC <<layer: Control>> {
}

' ---------- DAO layer (server only) ----------
package "server.dao" as SD <<layer: DAO>> {
}

' ---------- Common layer (packed into both JARs) ----------
package "common.protocol" as CP <<layer: Common>> {
}
package "common.entity" as CE <<layer: Common>> {
}

' ---------- Infrastructure (external) ----------
package "javafx" as FX <<framework>> #EEEEEE {
}
package "ocsf.client" as OC <<framework>> #EEEEEE {
}
package "ocsf.server" as OS <<framework>> #EEEEEE {
}
package "jdbc" as JD <<library>> #EEEEEE {
}

' ---------- Dependencies (all point downward: no cycles) ----------
' Client side
CB ..> CC : <<import>>
CB ..> CP : <<import>>
CB ..> CE : <<import>>
CB ..> FX : <<import>>
CC ..> CP : <<import>>
CC ..> CE : <<import>>
CC ..> OC : <<import>>

' Server side
SB ..> SC : <<import>>
SB ..> CE : <<import>>
SB ..> FX : <<import>>
SC ..> SD : <<import>>
SC ..> CP : <<import>>
SC ..> CE : <<import>>
SC ..> OS : <<import>>
SC ..> JD : <<access>>
SD ..> CE : <<import>>
SD ..> JD : <<import>>

note right of CC
  UpdateListener lives here and the screens in
  client.boundary inherit from it. CrisisSyncClient
  notifies the screens only through it (Observer),
  so client.control never depends on client.boundary.
end note

note right of SC
  Same idea on the server: ServerActivityListener
  and SettlementGateway live here; ServerMonitorScreen
  and SettlementSystemAdapter (server.boundary)
  inherit from them.
end note

note bottom of SD
  Only the server talks to MySQL.
  jdbc = java.sql + MySQL Connector/J.
  Clients reach data only through OCSF messages.
end note
@enduml
